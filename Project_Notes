Notes:

data/fastqs/* = makes the directory.

To make a hidden file, put a decimal in the front of the file name, to make it invisible.

.gitignore file

refdb/* (reference databases) = Is a directory

mkdir code/
mkdir plots/
mkdir results/

mkdir -p  data/fastqs

fastp
-in1 $f = forwrad reads
-in2 $r = reverse reads
-html mtl/${f%_name.fastq}
-out1 poly-G-trimmed$f
-out2 poly-G-trimmed$reads-cut_tail
-poly_g_min_len 4
-cut_tail_mean_quality 25
-cut_tail_window_size 2
-disable_adapter_trimming
-poly_g_min_len-g -0

echo $f